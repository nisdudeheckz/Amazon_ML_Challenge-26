# Settings for the AWS runner scripts (sourced by aws/*.sh). Edit freely.

AWS_REGION=us-east-1
# Globally unique S3 bucket for data, code and results. Empty = ber-<account id>-<region>.
BUCKET=ber-397379264773-us-east-1

# Instance: CPU-only work (polars, sparse top-K, LightGBM) — no GPU needed.
# This account's EC2 quota is 8 vCPUs, so the default is the 8-vCPU, 64 GiB r7i.2xlarge.
#   r7i.2xlarge  :  8 vCPU /  64 GiB  (~$0.53/h on-demand, us-east-1)
#   c7i.8xlarge  : 32 vCPU /  64 GiB  (~$1.43/h)  | need a higher vCPU quota
#   c7i.16xlarge : 64 vCPU / 128 GiB  (~$2.86/h)  |
INSTANCE_TYPE=r7i.2xlarge
SPOT=0              # 1 = spot instance (usually 50-70% cheaper, can be interrupted)
VOLUME_GB=100       # root disk (work dir ~12 GB, data 2.4 GB)

MAX_HOURS=4         # safety net: the instance terminates itself after this many hours
AUTO_SHUTDOWN=1     # 1 = terminate as soon as the run finishes (results are in S3 first)
KEEP_WORK=1         # 1 = upload work/ (~12 GB) so later runs can start from it (FROM_RUN)

# Pipeline knobs (see src/ber/config.py). ~14 GB RAM per parallel country.
BER_JOBS=1          # countries built in parallel (raise only on bigger instances)
BER_THREADS=        # empty = all vCPUs
BER_MAX_DF=6000
BER_TRAIN_FRAC=400
BER_SELF_TRAIN=0    # 1 = also write a self-trained variant to output/selftrain/
